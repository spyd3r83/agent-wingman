{
  "name": "opencode-agent-wingman",
  "version": "0.1.0",
  "description": "Local, detector-first struggle detection for OpenCode agents.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "agent-wingman-replay": "./dist/bin/replay.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "CONFIGURATION.md",
    "DETECTION.md",
    "PRIVACY.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run scripts/clean.ts && bun build src/index.ts bin/replay.ts --outdir dist --target bun --format esm && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "trace:replay": "bun run bin/replay.ts fixtures/traces/*.json",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:opencode": "bun run build && bun run scripts/opencode-smoke.ts",
    "package:check": "bun run build && bun run scripts/package-check.ts",
    "verify": "bun test && bun run typecheck && bun run trace:replay && bun run smoke && bun run package:check"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^24.12.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spyd3r83/agent-wingman.git"
  },
  "homepage": "https://github.com/spyd3r83/agent-wingman#readme",
  "bugs": {
    "url": "https://github.com/spyd3r83/agent-wingman/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai-agent",
    "developer-tools",
    "loop-detection",
    "typescript"
  ],
  "license": "Apache-2.0"
}
